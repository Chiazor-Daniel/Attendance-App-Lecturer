	<string>This app needs access to photo library to allow you to select profile pictures.</string>
	<!-- Motion Usage (if using device motion for attendance) -->
	<key>NSMotionUsageDescription</key>
	<string>This app uses motion data to enhance attendance verification.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
